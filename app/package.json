{
  "name": "auto-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Монтажёр рилсов на Remotion: транскрибация (faster-whisper), субтитры, камера, инфографика, видео в рамке",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "build": "node scripts/build.mjs",
    "render": "node scripts/build.mjs --render",
    "movies": "node scripts/movies.mjs",
    "palette": "node scripts/palette.mjs",
    "typecheck": "tsc -p .",
    "test": "npm run typecheck && node scripts/smoke-test.mjs",
    "music-index": "node scripts/music.mjs",
    "anim-assets": "node scripts/anim-assets.mjs",
    "enhance": "node scripts/enhance.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.528",
    "@remotion/fonts": "4.0.528",
    "d3-geo": "^3.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.528",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "19.3.0",
    "@types/topojson-client": "^3.1.5",
    "typescript": "7.0.2"
  }
}
